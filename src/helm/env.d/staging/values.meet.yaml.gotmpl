# Dark rollout defaults. The trusted Meet deployment consumes this overlay only
# after supplying its normal application configuration through Secrets.
backend:
  envVars:
    MASTRAO_MEETING_RECORDING_ENABLED: False
    MASTRAO_MEETING_RECORDING_START_ENABLED: False
    MASTRAO_MEETING_RECORDING_ARTIFACT_ACCESS_ENABLED: False
    RECORDING_ENABLE: False
  cronjobs:
    - name: clean-pending-files
      schedule: "30 0 * * *"
      command: ["/bin/sh", "-c", "python manage.py clean_pending_files"]
    - name: purge-deleted-files
      schedule: "45 0 * * *"
      command: ["/bin/sh", "-c", "python manage.py purge_deleted_files"]
    - name: reconcile-mastrao-recordings
      schedule: "* * * * *"
      concurrencyPolicy: Forbid
      startingDeadlineSeconds: 45
      backoffLimit: 1
      activeDeadlineSeconds: 1800
      ttlSecondsAfterFinished: 300
      command:
        - "/bin/sh"
        - "-c"
        - "python manage.py reconcile_mastrao_recordings --limit 2"
