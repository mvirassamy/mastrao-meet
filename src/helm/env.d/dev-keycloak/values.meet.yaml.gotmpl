
# ---- Frontend : Generic/white-label build (meet-frontend-generic) — Outlook add-in disabled ----
frontend:
  envVars:
    VITE_APP_TITLE: "LaSuite Meet"
    VITE_PORT: 8080
    VITE_HOST: 0.0.0.0
    VITE_API_BASE_URL: https://meet.127.0.0.1.nip.io/

  image:
    repository: localhost:5001/meet-frontend-generic
    pullPolicy: Always
    tag: "latest"

frontendNginxConfig:
  enabled: false
