<mjml lang="fr">
  <mj-include path="./partial/header.mjml" />
  <mj-body>
    <mj-wrapper css-class="wrapper" padding="0 40px 40px 40px">
      <mj-section>
        <mj-column>
          <mj-image align="center" src="{{logo_img}}" width="72px" alt="Logo {{brandname}}" />
        </mj-column>
      </mj-section>
      <mj-section padding="30px 20px 60px 20px">
        <mj-column>
          <mj-text font-size="18px">
            <p><a href="mailto:{{ sender_email }}">{{ sender_email }}</a> vous invite à rejoindre une visioconférence en cours sur {{brandname}}.</p>
          </mj-text>
          <mj-button href="{{ room_url }}" background-color="#1A73E8" color="white" border-radius="4px" font-weight="bold" font-size="16px" padding="20px 0">
            REJOINDRE LA VISIOCONFÉRENCE
          </mj-button>
          <mj-text align="center" color="#5F6368" font-size="14px" padding-top="15px">
            <p>{{ room_link }}</p>
          </mj-text>
          <mj-divider border-width="1px" border-style="solid" border-color="#EEEEEE" padding="30px 0" />
          <mj-text font-size="14px">
            <p>Si le bouton ne fonctionne pas, copiez et collez ce lien dans votre navigateur : {{ room_url }}</p>
          </mj-text>
          <mj-text padding-top="20px" font-size="14px">
            <p>Pour une meilleure expérience :</p>
            <ul>
              <li>Utilisez Chrome ou Firefox pour une meilleure qualité d’appel.</li>
              <li>Testez votre microphone et votre caméra avant de rejoindre la réunion.</li>
              <li>Vérifiez que votre connexion Internet est stable.</li>
            </ul>
          </mj-text>
          <mj-text font-size="14px">
            <p>Merci d’utiliser {{brandname}}.</p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-include path="./partial/footer.mjml" />
  </mj-body>
</mjml>
