{
  "apiVersion": "cilium.io/v2",
  "kind": "CiliumNetworkPolicy",
  "metadata": {
    "name": "native-asr-worker-destinations-private-v1",
    "namespace": "mastrao-staging"
  },
  "specs": [
    {
      "endpointSelector": {
        "matchLabels": {
          "app.kubernetes.io/name": "cabinet-core"
        }
      },
      "ingress": [
        {
          "fromEndpoints": [
            {
              "matchExpressions": [
                {
                  "key": "k8s:app.kubernetes.io/name",
                  "operator": "In",
                  "values": ["worker-native-asr-ready", "worker-native-asr-retry"]
                }
              ],
              "matchLabels": {
                "k8s:io.kubernetes.pod.namespace": "mastrao-staging"
              }
            }
          ],
          "toPorts": [
            {
              "ports": [{"port": "18081", "protocol": "TCP"}]
            }
          ]
        }
      ]
    }
  ]
}
