{
  "apiVersion": "cilium.io/v2",
  "kind": "CiliumNetworkPolicy",
  "metadata": {
    "name": "meet-api-private-start",
    "namespace": "mastrao-staging"
  },
  "spec": {
    "endpointSelector": {
      "matchLabels": {
        "app.kubernetes.io/name": "meet-api",
        "mastrao.com/component": "meet-api"
      }
    },
    "ingress": [
      {
        "fromEntities": ["host"],
        "toPorts": [
          {
            "ports": [{"port": "8000", "protocol": "TCP"}]
          }
        ]
      },
      {
        "fromEndpoints": [
          {
            "matchLabels": {
              "k8s:app.kubernetes.io/name": "meet-api-qualification",
              "k8s:io.kubernetes.pod.namespace": "mastrao-staging"
            }
          }
        ],
        "toPorts": [
          {
            "ports": [{"port": "8000", "protocol": "TCP"}]
          }
        ]
      },
      {
        "fromEndpoints": [
          {
            "matchLabels": {
              "k8s:io.cilium.k8s.policy.serviceaccount": "cabinet-core",
              "k8s:io.kubernetes.pod.namespace": "mastrao-staging"
            }
          }
        ],
        "toPorts": [
          {
            "ports": [{"port": "8000", "protocol": "TCP"}]
          }
        ]
      }
    ],
    "egress": [
      {
        "toCIDR": ["172.16.8.8/32"],
        "toPorts": [
          {
            "ports": [{"port": "5432", "protocol": "TCP"}]
          }
        ]
      },
      {
        "toEndpoints": [
          {
            "matchLabels": {
              "k8s:app.kubernetes.io/name": "redis-meet",
              "k8s:io.kubernetes.pod.namespace": "mastrao-staging"
            }
          }
        ],
        "toPorts": [
          {
            "ports": [{"port": "6379", "protocol": "TCP"}]
          }
        ]
      },
      {
        "toEndpoints": [
          {
            "matchLabels": {
              "k8s:io.kubernetes.pod.namespace": "kube-system",
              "k8s:k8s-app": "kube-dns"
            }
          }
        ],
        "toPorts": [
          {
            "ports": [{"port": "53", "protocol": "ANY"}],
            "rules": {
              "dns": [
                {"matchName": "s3.fr-par.scw.cloud"},
                {"matchName": "mastrao-staging-meet-egress-captures.s3.fr-par.scw.cloud"},
                {"matchName": "cabinet-core.mastrao-staging.svc.cluster.local"},
                {"matchName": "livekit-signal.mastrao-staging.svc.cluster.local"},
                {"matchName": "app.mastrao-staging.com"}
              ]
            }
          }
        ]
      },
      {
        "toFQDNs": [
          {"matchName": "s3.fr-par.scw.cloud"},
          {"matchName": "mastrao-staging-meet-egress-captures.s3.fr-par.scw.cloud"},
          {"matchName": "app.mastrao-staging.com"}
        ],
        "toPorts": [
          {
            "ports": [{"port": "443", "protocol": "TCP"}]
          }
        ]
      },
      {
        "toEndpoints": [
          {
            "matchLabels": {
              "k8s:io.cilium.k8s.policy.serviceaccount": "cabinet-core",
              "k8s:io.kubernetes.pod.namespace": "mastrao-staging"
            }
          }
        ],
        "toPorts": [
          {
            "ports": [{"port": "8080", "protocol": "TCP"}]
          }
        ]
      },
      {
        "toEntities": ["remote-node", "host"],
        "toPorts": [
          {
            "ports": [{"port": "7880", "protocol": "TCP"}]
          }
        ]
      }
    ]
  }
}
