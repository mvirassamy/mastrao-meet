{
  "apiVersion": "cilium.io/v2",
  "kind": "CiliumNetworkPolicy",
  "metadata": {
    "name": "metadata-collector-private-v1",
    "namespace": "mastrao-staging"
  },
  "spec": {
    "endpointSelector": {
      "matchLabels": {
        "app.kubernetes.io/component": "metadata-collector",
        "app.kubernetes.io/name": "metadata-collector"
      }
    },
    "enableDefaultDeny": {
      "egress": true,
      "ingress": true
    },
    "ingress": [],
    "egress": [
      {
        "toEndpoints": [
          {
            "matchLabels": {
              "k8s:io.kubernetes.pod.namespace": "kube-system",
              "k8s:k8s-app": "kube-dns"
            }
          }
        ],
        "toPorts": [
          {
            "ports": [{"port": "53", "protocol": "ANY"}],
            "rules": {
              "dns": [
                {"matchName": "livekit-signal.mastrao-staging.svc.cluster.local"},
                {"matchName": "cabinet-core.mastrao-staging.svc.cluster.local"},
                {"matchName": "s3.fr-par.scw.cloud"},
                {"matchName": "mastrao-staging-meet-egress-captures.s3.fr-par.scw.cloud"}
              ]
            }
          }
        ]
      },
      {
        "toEndpoints": [
          {
            "matchLabels": {
              "k8s:io.cilium.k8s.policy.serviceaccount": "cabinet-core",
              "k8s:io.kubernetes.pod.namespace": "mastrao-staging"
            }
          }
        ],
        "toPorts": [
          {
            "ports": [{"port": "8080", "protocol": "TCP"}]
          }
        ]
      },
      {
        "toFQDNs": [
          {"matchName": "s3.fr-par.scw.cloud"},
          {"matchName": "mastrao-staging-meet-egress-captures.s3.fr-par.scw.cloud"}
        ],
        "toPorts": [
          {
            "ports": [{"port": "443", "protocol": "TCP"}]
          }
        ]
      },
      {
        "toEntities": ["remote-node", "host"],
        "toPorts": [
          {
            "ports": [
              {"port": "7880", "protocol": "TCP"},
              {"port": "7881", "protocol": "TCP"},
              {"port": "7882", "protocol": "UDP"}
            ]
          }
        ]
      }
    ]
  }
}
